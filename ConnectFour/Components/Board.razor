@using System.Drawing
@inject GameState State

<HeadContent>
    <style>
            :root {
                --board-bg:
                    @ColorTranslator.ToHtml(BoardColor)
                ;
                --player1:
                    @ColorTranslator.ToHtml(Player1Color)
                ;
                --player2:
                    @ColorTranslator.ToHtml(Player2Color)
                ;
            }
    </style>
</HeadContent>




<section class="streak-board">
    <div class="streak-card player1-streak">
        <h3>Player 1</h3>
        <p>@player1Streak</p>
        <span>Consecutive Wins</span>
    </div>

    <div class="streak-card player2-streak">
        <h3>Player 2</h3>
        <p>@player2Streak</p>
        <span>Consecutive Wins</span>
    </div>
</section>

<article>
    @winnerMessage
    <br />
    <span class="alert-danger">@errorMessage</span>
    <span class="alert-info">@CurrentTurn</span>
</article>

<nav>
    @for (byte i = 0; i < 7; i++)
    {
        var col = i;
        <span title="Click to play a piece" @onclick="() => PlayPiece(col)">🔽</span>
    }
</nav>




<div>
    <div class="board">
        @for (var i = 0; i < 42; i++)
        {
            <span class="container">
                <span></span>
            </span>
        }
    </div>

    @for (var i = 0; i < 42; i++)
    {
        <span class="@pieces[i]"></span>
    }
</div>


<article class="game-controls">
    <button class="new-game-button" style="@ResetStyle" @onclick="ResetGame">
        New Game
    </button>

    <button class="reset-everything-button" @onclick="RequestFullReset">
        Reset Everything
    </button>

    @if (showResetConfirmation)
    {
        <div class="reset-confirmation">
            <p>
                Are you sure? This will clear the board
                and both players' winning streaks.
            </p>

            <button class="confirm-reset-button" @onclick="ConfirmFullReset">
                Yes, Reset Everything
            </button>

            <button class="cancel-reset-button" @onclick="CancelFullReset">
                Cancel
            </button>
        </div>
    }
</article>





@code {
    private string[] pieces = new string[42];

    private string winnerMessage = string.Empty;
    private string errorMessage = string.Empty;
    
    // Winning streak tracking
    private int player1Streak = 0;
    private int player2Streak = 0;

    // Prevent recording the same game result more than once
    private bool gameResultRecorded = false;

    private bool showResetConfirmation = false;

    private string CurrentTurn =>
        (winnerMessage == string.Empty)
            ? $"Player {State.PlayerTurn}'s Turn"
            : "";

    private string ResetStyle =>
        (winnerMessage == string.Empty)
            ? "display: none;"
            : "";

    [Parameter]
    public Color BoardColor { get; set; } = ColorTranslator.FromHtml("yellow");

    [Parameter]
    public Color Player1Color { get; set; } = ColorTranslator.FromHtml("red");

    [Parameter]
    public Color Player2Color { get; set; } = ColorTranslator.FromHtml("blue");


    protected override void OnInitialized()
    {
        State.ResetBoard();
    }

    private void PlayPiece(byte col)
    {
        errorMessage = string.Empty;

        try
        {
            var player = State.PlayerTurn;
            var turn = State.CurrentTurn;
            var landingRow = State.PlayPiece(col);

            pieces[turn] = $"player{player} col{col} drop{landingRow}";

            var result = State.CheckForWin();

            switch (result)
            {
                case GameState.WinState.Player1_Wins:

                    winnerMessage = "Player 1 Wins!";

                    if (!gameResultRecorded)
                    {
                        player1Streak++;
                        player2Streak = 0;
                        gameResultRecorded = true;
                    }

                    break;

                case GameState.WinState.Player2_Wins:

                    winnerMessage = "Player 2 Wins!";

                    if (!gameResultRecorded)
                    {
                        player2Streak++;
                        player1Streak = 0;
                        gameResultRecorded = true;
                    }

                    break;

                case GameState.WinState.Tie:

                    winnerMessage = "It's a tie!";

                    if (!gameResultRecorded)
                    {
                        player1Streak = 0;
                        player2Streak = 0;
                        gameResultRecorded = true;
                    }

                    break;

                default:

                    winnerMessage = string.Empty;

                    break;
            }
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ResetGame()
    {
        State.ResetBoard();

        winnerMessage = string.Empty;
        errorMessage = string.Empty;

        pieces = new string[42];

        gameResultRecorded = false;
    }


    private void RequestFullReset()
    {
        showResetConfirmation = true;
    }

    private void CancelFullReset()
    {
        showResetConfirmation = false;
    }

    private void ConfirmFullReset()
    {
        // Start a fresh game
        ResetGame();

        // Clear both players' winning streaks
        player1Streak = 0;
        player2Streak = 0;

        // Close the confirmation message
        showResetConfirmation = false;
    }

}